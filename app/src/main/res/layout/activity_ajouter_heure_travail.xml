<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AjouterAbonnementActivity">
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".AjouterHeureTravailActivity">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg2" />

    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A0000000" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1F1F1F"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#FFFFFF"
            android:onClick="openDrawer"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="GÉRER LES HORAIRES"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="invisible" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HORAIRES DE LA SEMAINE"
                android:textColor="#FF6B35"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#1F1F1F"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Lundi"
                        android:textColor="#E0E0E0"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/editTextStartTimeMonday"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#2D2D2D"
                        android:gravity="center"
                        android:hint="Début"
                        android:inputType="time"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9E9E9E"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="-"
                        android:textColor="#9E9E9E" />

                    <EditText
                        android:id="@+id/editTextEndTimeMonday"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#2D2D2D"
                        android:gravity="center"
                        android:hint="Fin"
                        android:inputType="time"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9E9E9E"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#3A3A3A" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Mardi"
                        android:textColor="#E0E0E0"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/editTextStartTimeTuesday"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#2D2D2D"
                        android:gravity="center"
                        android:hint="Début"
                        android:inputType="time"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9E9E9E"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="-"
                        android:textColor="#9E9E9E" />

                    <EditText
                        android:id="@+id/editTextEndTimeTuesday"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#2D2D2D"
                        android:gravity="center"
                        android:hint="Fin"
                        android:inputType="time"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9E9E9E"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#3A3A3A" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Mercredi"
                        android:textColor="#E0E0E0"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/editTextStartTimeWednesday"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#2D2D2D"
                        android:gravity="center"
                        android:hint="Début"
                        android:inputType="time"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9E9E9E"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="-"
                        android:textColor="#9E9E9E" />

                    <EditText
                        android:id="@+id/editTextEndTimeWednesday"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#2D2D2D"
                        android:gravity="center"
                        android:hint="Fin"
                        android:inputType="time"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9E9E9E"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#3A3A3A" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Jeudi"
                        android:textColor="#E0E0E0"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/editTextStartTimeThursday"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#2D2D2D"
                        android:gravity="center"
                        android:hint="Début"
                        android:inputType="time"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9E9E9E"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="-"
                        android:textColor="#9E9E9E" />

                    <EditText
                        android:id="@+id/editTextEndTimeThursday"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#2D2D2D"
                        android:gravity="center"
                        android:hint="Fin"
                        android:inputType="time"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9E9E9E"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#3A3A3A" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Vendredi"
                        android:textColor="#E0E0E0"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/editTextStartTimeFriday"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#2D2D2D"
                        android:gravity="center"
                        android:hint="Début"
                        android:inputType="time"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9E9E9E"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="-"
                        android:textColor="#9E9E9E" />

                    <EditText
                        android:id="@+id/editTextEndTimeFriday"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#2D2D2D"
                        android:gravity="center"
                        android:hint="Fin"
                        android:inputType="time"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9E9E9E"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#3A3A3A" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Samedi"
                        android:textColor="#E0E0E0"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/editTextStartTimeSaturday"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#2D2D2D"
                        android:gravity="center"
                        android:hint="Début"
                        android:inputType="time"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9E9E9E"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="-"
                        android:textColor="#9E9E9E" />

                    <EditText
                        android:id="@+id/editTextEndTimeSaturday"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#2D2D2D"
                        android:gravity="center"
                        android:hint="Fin"
                        android:inputType="time"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9E9E9E"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#3A3A3A" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Dimanche"
                        android:textColor="#E0E0E0"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/editTextStartTimeSunday"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#2D2D2D"
                        android:gravity="center"
                        android:hint="Début"
                        android:inputType="time"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9E9E9E"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="-"
                        android:textColor="#9E9E9E" />

                    <EditText
                        android:id="@+id/editTextEndTimeSunday"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#2D2D2D"
                        android:gravity="center"
                        android:hint="Fin"
                        android:inputType="time"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9E9E9E"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/saveHoursButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#2196F3"
                android:text="ENREGISTRER LES HORAIRES"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="FERMETURES EXCEPTIONNELLES"
                android:textColor="#FF6B35"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#2A2A2A"
                android:orientation="vertical"
                android:padding="20dp">

                <EditText
                    android:id="@+id/editTextClosureDate"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="#1F1F1F"
                    android:hint="Date (JJ/MM/AAAA)"
                    android:inputType="date"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#9E9E9E" />

                <EditText
                    android:id="@+id/editTextClosureReason"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="#1F1F1F"
                    android:hint="Raison (ex: Jour Férié)"
                    android:inputType="text"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#9E9E9E" />

                <Button
                    android:id="@+id/addClosureButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#FF6B35"
                    android:text="AJOUTER LA FERMETURE"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                android:background="#1F1F1F"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25/04/2026"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="AID ELKEBIR"
                        android:textColor="#B0B0B0"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/deleteClosureButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:backgroundTint="#F44336"
                    android:text="SUPPRIMER"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:menu="@menu/drawer_menu"
        app:headerLayout="@layout/nav_header" />

</androidx.drawerlayout.widget.DrawerLayout>