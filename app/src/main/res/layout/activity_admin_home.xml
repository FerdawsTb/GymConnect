<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Arrière-plan et superposition -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/bg2" />

    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000" />

    <!-- Barre supérieure -->
    <TextView
        android:id="@+id/welcomeMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:text="Bonjour, Admin"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/profileImage"/>

    <com.google.android.material.chip.Chip
        android:id="@+id/adminChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ADMINISTRATEUR"
        android:textColor="#FFFFFF"
        app:chipBackgroundColor="#2196F3"
        app:chipIcon="@android:drawable/ic_secure"
        app:chipIconTint="#FFFFFF"
        app:layout_constraintStart_toStartOf="@id/welcomeMessage"
        app:layout_constraintTop_toBottomOf="@id/welcomeMessage" />

    <ImageView
        android:id="@+id/profileImage"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="20dp"
        android:contentDescription="Profile"
        android:padding="6dp"
        app:srcCompat="@drawable/outline_account_circle_24"
        app:tint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/welcomeMessage"
        app:layout_constraintBottom_toBottomOf="@id/adminChip"/>

    <!-- Carte Principale : Profit du Jour -->
    <androidx.cardview.widget.CardView
        android:id="@+id/profitCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/adminChip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dashboard_card_profit_bg"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profit du Jour"
                android:textColor="#E0E0E0"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/profitValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="1,250 DT"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profitComparison"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▲ +15% vs hier"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Grille de statistiques -->
    <GridLayout
        android:id="@+id/statsGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:columnCount="2"
        android:useDefaultMargins="true"
        app:layout_constraintTop_toBottomOf="@id/profitCard"
        app:layout_constraintStart_toStartOf="@id/profitCard"
        app:layout_constraintEnd_toEndOf="@id/profitCard">

        <!-- Statistique : Revenus -->
        <androidx.cardview.widget.CardView style="@style/DashboardCard">
            <LinearLayout style="@style/DashboardCardLayout">
                <ImageView style="@style/DashboardCardIcon" android:src="@android:drawable/ic_menu_add" app:tint="#4CAF50"/>
                <TextView style="@style/DashboardCardTitle" android:text="Revenus du ce mois"/>
                <TextView style="@style/DashboardCardValue" android:id="@+id/incomeValue" android:text="2,000 DT" android:textColor="#4CAF50"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Statistique : Dépenses -->
        <androidx.cardview.widget.CardView style="@style/DashboardCard">
            <LinearLayout style="@style/DashboardCardLayout">
                <ImageView style="@style/DashboardCardIcon" android:src="@android:drawable/ic_menu_delete" app:tint="#F44336"/>
                <TextView style="@style/DashboardCardTitle" android:text="Dépenses/mois"/>
                <TextView style="@style/DashboardCardValue" android:id="@+id/expenseValue" android:text="750 DT" android:textColor="#F44336"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Statistique : Nouveaux Membres -->
        <androidx.cardview.widget.CardView style="@style/DashboardCard">
            <LinearLayout style="@style/DashboardCardLayout">
                <ImageView style="@style/DashboardCardIcon" android:src="@android:drawable/ic_menu_myplaces" app:tint="#2196F3"/>
                <TextView style="@style/DashboardCardTitle" android:text="Membres inscrit/mois"/>
                <TextView style="@style/DashboardCardValue" android:id="@+id/newMembersValue" android:text="8" android:textColor="#2196F3"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Statistique : Total Membres -->
        <androidx.cardview.widget.CardView style="@style/DashboardCard">
            <LinearLayout style="@style/DashboardCardLayout">
                <ImageView style="@style/DashboardCardIcon" android:src="@android:drawable/ic_menu_gallery" app:tint="#FFC107"/>
                <TextView style="@style/DashboardCardTitle" android:text="Membres Actifs"/>
                <TextView style="@style/DashboardCardValue" android:id="@+id/totalMembersValue" android:text="256" android:textColor="#FFC107"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </GridLayout>


    <!-- Actions Rapides -->

</androidx.constraintlayout.widget.ConstraintLayout>