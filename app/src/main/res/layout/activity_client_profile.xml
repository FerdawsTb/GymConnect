<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- CONTENU PRINCIPAL (Ton design original) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1A1A1A"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- BOUTON MENU : Appelle la méthode openDrawer de BaseDrawerActivity -->
            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:onClick="openDrawer"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="20dp"
                android:text="Profil Client"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Carte Identité -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#2D2D2D"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginEnd="16dp">
                    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#404040" />
                    <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="2dp" android:background="#FF6B35" />
                    <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="5dp" android:background="#2D2D2D" />
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="👤" android:textSize="35sp" android:gravity="center" android:textColor="#FFFFFF" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView android:id="@+id/clientName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chargement..." android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:id="@+id/clientEmail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="..." android:textColor="#B0B0B0" android:textSize="14sp" android:paddingTop="4dp" />
                    <TextView android:id="@+id/memberSince" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="..." android:textColor="#B0B0B0" android:textSize="12sp" android:paddingTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Objectif -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2D2D2D"
                android:padding="16dp"
                android:layout_marginBottom="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Objectif Actuel" android:textColor="#FF6B35" android:textSize="16sp" android:textStyle="bold" android:paddingBottom="8dp" />
                <TextView android:id="@+id/clientGoal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Développer la masse musculaire et augmenter la force" android:textColor="#FFFFFF" android:textSize="14sp" />
            </LinearLayout>

            <!-- Abonnement Actif -->
            <LinearLayout
                android:id="@+id/activeSubscriptionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2D2D2D"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="visible">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Abonnement Actif" android:textColor="#FF6B35" android:textSize="16sp" android:textStyle="bold" android:paddingBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:id="@+id/subscriptionType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Plan Mensuel" android:textColor="#00CED1" android:textSize="16sp" android:textStyle="bold" android:background="#1A4D4D" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" />
                    <TextView android:id="@+id/subscriptionStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="✓ Actif" android:textColor="#4CAF50" android:textSize="14sp" android:textStyle="bold" android:background="#1A3D1A" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" />
                </LinearLayout>
                <TextView android:id="@+id/subscriptionExpiry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Expire le : 28/12/2025" android:textColor="#E0E0E0" android:textSize="13sp" android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/daysRemaining" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 15 jours restants" android:textColor="#FFC107" android:textSize="13sp" />
            </LinearLayout>

            <!-- Historique -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2D2D2D"
                android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Historique des Abonnements" android:textColor="#FF6B35" android:textSize="16sp" android:textStyle="bold" android:paddingBottom="12dp" />
                <LinearLayout android:id="@+id/historyLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Plan Mensuel" android:textColor="#FFFFFF" android:textSize="14sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="01/09/2025 - 01/10/2025" android:textColor="#B0B0B0" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- MENU LATÉRAL -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:menu="@menu/drawer_menu"
        app:headerLayout="@layout/nav_header" />

</androidx.drawerlayout.widget.DrawerLayout>